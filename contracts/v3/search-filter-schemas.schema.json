{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eostage.local/contracts/v3/search-filter-schemas.schema.json",
  "title": "EOStage search filter schemas v1",
  "description": "Reviewed, EOStage-owned discovery predicates per science dataset. Maps to the route-neutral CatalogSearchQuery filter vocabulary. Never contains provider endpoints, native collection ids, native field names, credentials, or executable expressions. Rust (insar-core search_filter_schema) is the enforcing validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "review_version",
    "schemas"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "const": "eostage.search-filter-schemas.v1"
    },
    "review_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/schema"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label",
        "description"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/token"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "registry_platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_revision",
        "resource_id",
        "dataset_label",
        "description",
        "filters"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^search\\.[a-z0-9.-]+\\.v[0-9]+$"
        },
        "schema_revision": {
          "type": "integer",
          "minimum": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "workbench": {
          "$ref": "#/$defs/workbench"
        },
        "filters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/filter"
          }
        }
      }
    },
    "workbench": {
      "description": "Presentation placement only; grants no route, credential or delivery. logical_dataset must equal the Registry catalogue_logical_dataset.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel",
        "dataset_key",
        "order",
        "logical_dataset",
        "search_action_label",
        "result_hint"
      ],
      "properties": {
        "panel": {
          "enum": [
            "optical"
          ]
        },
        "dataset_key": {
          "$ref": "#/$defs/key"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "logical_dataset": {
          "type": "string",
          "minLength": 1
        },
        "search_action_label": {
          "type": "string",
          "minLength": 1
        },
        "result_hint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "filter_id",
            "label",
            "group",
            "query_key",
            "options",
            "default",
            "empty_selection",
            "invalid_message"
          ],
          "properties": {
            "control": {
              "const": "multi_enum"
            },
            "filter_id": {
              "$ref": "#/$defs/token"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "const": "facet"
            },
            "query_key": {
              "$ref": "#/$defs/key"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/option"
              }
            },
            "default": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "empty_selection": {
              "enum": [
                "omit",
                "restore_all"
              ]
            },
            "invalid_message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "filter_id",
            "label",
            "group",
            "options"
          ],
          "properties": {
            "control": {
              "const": "fixed"
            },
            "filter_id": {
              "$ref": "#/$defs/token"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "const": "facet"
            },
            "query_key": {
              "$ref": "#/$defs/key"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/option"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "filter_id",
            "label",
            "group",
            "query_key"
          ],
          "properties": {
            "control": {
              "const": "date_range"
            },
            "filter_id": {
              "$ref": "#/$defs/token"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "enum": [
                "time",
                "quality"
              ]
            },
            "query_key": {
              "$ref": "#/$defs/key"
            },
            "help": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "filter_id",
            "label",
            "group",
            "query_key",
            "operator",
            "minimum",
            "maximum",
            "invalid_message"
          ],
          "properties": {
            "control": {
              "const": "number"
            },
            "filter_id": {
              "$ref": "#/$defs/token"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "enum": [
                "time",
                "quality"
              ]
            },
            "query_key": {
              "$ref": "#/$defs/key"
            },
            "operator": {
              "enum": [
                "lte",
                "gte"
              ]
            },
            "minimum": {
              "type": "number",
              "minimum": 0
            },
            "maximum": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "default": {
              "type": [
                "number",
                "null"
              ]
            },
            "placeholder": {
              "type": "string"
            },
            "invalid_message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
