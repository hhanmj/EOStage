    {
      "name": "exact_polygon_with_local_multi_filters",
      "query": {
        "version": 1,
        "dataset": "SENTINEL-1",
        "bbox": {"west": -10.0, "east": 10.0, "south": -10.0, "north": 10.0, "crs": "EPSG:4326"},
        "aoi": "province",
        "aoi_geojson": {"type": "Polygon", "coordinates": [[[0, 0], [1, 0], [1, 1], [0, 1], [0, 0]]]},
        "start": "2024/01/01",
        "end": "2024-01-31",
        "product_type": "GRD",
        "beam_mode": "IW,EW",
        "polarization": "DV,DH",
        "orbit_direction": "ASCENDING,DESCENDING",
        "relative_orbit": "42-48,50",
        "frame": "100",
        "max_results": 60
      },
      "expected_requested_limit": 60,
      "expected_query_limit": 240,
      "expected_count": true,
      "expected_aoi_mode": "exact",
      "expected_params": {
        "dataset": "SENTINEL-1",
        "processingLevel": "GRD",
        "output": "geojson",
        "maxResults": "240",
        "start": "2024-01-01T00:00:00Z",
        "end": "2024-01-31T23:59:59Z",
        "intersectsWith": "POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))",
        "relativeOrbit": "42-48,50",
        "frame": "100"
      }
    },
    {
