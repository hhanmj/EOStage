{
  "name": "eostage-ui",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "2.2.0-beta.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tauri": "vite --config vite.tauri.config.ts build",
    "dev:tauri": "vite --config vite.tauri.config.ts --host 127.0.0.1 --port 5173",
    "tauri:dev": "cd .. && tauri dev --config src-tauri/tauri.dev.conf.json",
    "check": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types src/lib/*.test.ts src/shell/api/*.test.ts src/i18n/*.test.ts",
    "test:desktop-contracts": "node --test --experimental-strip-types src/lib/desktopMutationContracts.test.ts src/lib/desktopShellBridge.test.ts src/lib/bridgeErrorFormat.test.ts src/lib/providerFailureRecovery.test.ts",
    "test:interaction": "tsx --test --test-concurrency=2 \"src/**/*.interaction.test.tsx\" \"tests/**/*.interaction.test.tsx\" \"tests/**/*.interaction.test.ts\"",
    "test": "npm run test:unit && npm run test:interaction",
    "test:all": "npm run check && npm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.1.6"
  }
}
